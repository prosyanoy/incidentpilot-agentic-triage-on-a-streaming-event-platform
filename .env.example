# All values are optional; these are the safe local defaults.
# Event bus: "memory://" (in-process) or "nats://localhost:4222"
INCIDENTPILOT_BUS_URL=memory://
INCIDENTPILOT_BUS_SUBJECT=incidentpilot.events
# DuckDB file ("" or ":memory:" for in-memory)
INCIDENTPILOT_DB_PATH=:memory:
# LLM backend: "mock" (deterministic, offline) or "ollama"
INCIDENTPILOT_LLM=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Generator (used by the generator job)
INCIDENTPILOT_SCENARIO=bad_deploy
INCIDENTPILOT_SEED=7
INCIDENTPILOT_SPEED=20
